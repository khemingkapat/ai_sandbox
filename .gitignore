data/logs/*
data/results/*
data/examples/*
.env
jobs/

/storage/*
!/storage/common/
*.sif

# Ignore Kaggle cache, registry data, models, datasets, scratch, and general caches
/storage/registry/
/storage/models/
/storage/datasets/
/storage/scratch/
/storage/common/kaggle_cache/
**/__pycache__/
**/*.pyc

# Projects: Runtime user workspaces are ephemeral & dynamically provisioned
/storage/projects/
/storage/**/*.ipynb

storage.bak/

traefik-dynamic/*
!traefik-dynamic/.gitkeep

*.ignore.*

# Ignore compiled portal binary
portal/portal
/storage/projects/**/.jupyter/
/storage/projects/**/.npm/
/storage/projects/**/.local/
/storage/projects/**/.cache/
/storage/projects/**/.config/
/storage/projects/**/.kaggle/
