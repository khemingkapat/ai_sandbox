data/logs/*
data/results/*
data/examples/*
.env
jobs/

/storage/*
!/storage/**/
!/storage/**/*.def
!/storage/**/*.yaml
!/storage/**/*.yml
/storage/**/*.sif

# Ignore Kaggle cache, registry data, and general caches
/storage/registry/
/storage/common/kaggle_cache/
**/__pycache__/
**/*.pyc

# Projects: Keep project1 as the example, ignore other projects completely
/storage/projects/*
!/storage/projects/project1/
/storage/projects/project1/.bash_history

# Exclude temporary, log, and user-specific files in project1 (the example project)
/storage/projects/project1/logs/
/storage/projects/project1/.ipynb_checkpoints/
/storage/projects/project1/.apptainer/
/storage/projects/project1/slurm-*.out
/storage/**/*.ipynb
/storage/projects/*.log

storage.bak/

traefik-dynamic/*
!traefik-dynamic/.gitkeep

*.ignore.*

# Ignore compiled portal binary
portal/portal
/storage/projects/**/.jupyter/
/storage/projects/**/.npm/
/storage/projects/**/.local/
/storage/projects/**/.cache/
/storage/projects/**/.config/
