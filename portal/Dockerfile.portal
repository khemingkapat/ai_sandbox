# --- Stage 1: Build the Go binary ---
FROM golang:bookworm AS builder

WORKDIR /app

# Copy the Go module file
COPY go.mod ./

# Copy all the Go code FIRST so `go mod tidy` can read the imports
COPY . .

# Now run go mod tidy. It will scan main.go and port_manager.go, 
# download the required packages (Echo, SQLite, JWT, YAML), and generate go.sum.
RUN go mod tidy

# Build the application. CGO_ENABLED=1 is REQUIRED for SQLite in Go
RUN CGO_ENABLED=1 GOOS=linux go build -o hpc-portal .

# --- Stage 2: Create the final minimal image ---
FROM debian:bookworm-slim

# Install ca-certificates and curl (curl is used if you want to test APIs inside)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/hpc-portal .

# Copy your HTML templates
COPY templates/ templates/

# Expose the port
EXPOSE 8080

# Run the Go binary
CMD ["./hpc-portal"]
