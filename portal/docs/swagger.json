{
    "swagger": "2.0",
    "info": {
        "description": "AI Sandbox student workloads and cluster telemetry API.",
        "title": "AI Sandbox Portal API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/cluster/status": {
            "get": {
                "description": "Returns active Slurm jobs, pending queue depth, and available CPU nodes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "student"
                ],
                "summary": "Cluster job and node status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Slurm Client Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/jobs": {
            "get": {
                "description": "Returns a list of all Slurm batch jobs submitted by the authenticated user.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "student"
                ],
                "summary": "List current user's batch jobs",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Slurm API Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/tokens/inference": {
            "get": {
                "description": "Generates or returns an HMAC-SHA256 signed Bearer token for central vLLM inference API access.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "student"
                ],
                "summary": "Get inference API token",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/telemetry": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns aggregate status, active user headcount, queue depth, and service health.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telemetry"
                ],
                "summary": "Cluster health \u0026 telemetry",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.TelemetryResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Instant zero-allocation health check. Does not touch downstream network or storage.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telemetry"
                ],
                "summary": "Kubelet liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.TelemetryResponse": {
            "type": "object",
            "properties": {
                "active_users": {
                    "type": "integer",
                    "example": 2
                },
                "services": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "timestamp": {
                    "type": "string"
                },
                "workloads": {
                    "$ref": "#/definitions/main.WorkloadMetrics"
                }
            }
        },
        "main.WorkloadMetrics": {
            "type": "object",
            "properties": {
                "interactive_sessions": {
                    "type": "integer",
                    "example": 1
                },
                "queue_depth": {
                    "type": "integer",
                    "example": 0
                },
                "running_jobs": {
                    "type": "integer",
                    "example": 1
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}