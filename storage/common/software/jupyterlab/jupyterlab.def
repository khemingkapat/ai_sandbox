Bootstrap: docker
From: rockylinux:9

%post
    dnf install -y python3 python3-pip && \
    pip3 install --no-cache-dir \
        jupyterlab \
        numpy \
        pandas \
        matplotlib \
        seaborn \
        scipy \
        plotly

%test
    python3 -c "import jupyterlab, numpy, pandas; print('Build Successful')"

%runscript
    exec jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root
