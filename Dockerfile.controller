FROM giovtorres/slurm-docker-cluster:25.11.2

# Upgrade Apptainer to version with proot support.
# We install the SUID variant — this is required for proot fallback.
# When allow setuid = no, Apptainer uses proot instead of setuid,
# but only if starter-suid binary is present (installed by suid RPM).
RUN dnf remove -y apptainer 2>/dev/null || true && \
    dnf install -y wget epel-release && \
    APPTAINER_VERSION=1.3.6 && \
    wget -q "https://github.com/apptainer/apptainer/releases/download/v${APPTAINER_VERSION}/apptainer-${APPTAINER_VERSION}-1.x86_64.rpm" \
         -O /tmp/apptainer.rpm && \
    wget -q "https://github.com/apptainer/apptainer/releases/download/v${APPTAINER_VERSION}/apptainer-suid-${APPTAINER_VERSION}-1.x86_64.rpm" \
         -O /tmp/apptainer-suid.rpm && \
    dnf install -y /tmp/apptainer.rpm /tmp/apptainer-suid.rpm && \
    rm /tmp/apptainer.rpm /tmp/apptainer-suid.rpm && \
    dnf clean all

# Install proot static binary
RUN curl -fsSL \
      https://github.com/proot-me/proot/releases/download/v5.3.0/proot-v5.3.0-x86_64-static \
      -o /usr/local/bin/proot && \
    chmod +x /usr/local/bin/proot

# Configure Apptainer: disable setuid (triggers proot fallback) and set proot path
RUN sed -i 's/^allow setuid = yes/allow setuid = no/' /etc/apptainer/apptainer.conf && \
    echo "proot path = /usr/local/bin/proot" >> /etc/apptainer/apptainer.conf

# Add user1 subuid/subgid inside the container
RUN echo "user1:100000:65536" >> /etc/subuid && \
    echo "user1:100000:65536" >> /etc/subgid

# Fix newuidmap/newgidmap setuid bits
RUN chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap

# Verify starter-suid exists
RUN ls -la /usr/libexec/apptainer/bin/starter-suid
